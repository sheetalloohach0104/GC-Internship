from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.common.keys import Keys
import time

# Function to scrape Google search results
def scrape_google_search(query, max_results=10):
    # Initialize the WebDriver (Make sure to have the appropriate driver for your browser)
    driver = webdriver.Chrome()

    try:
        # Open Google
        driver.get("https://www.google.com")

        # Find the search bar and enter the query
        search_box = driver.find_element(By.NAME, "q")
        search_box.send_keys(query)
        search_box.send_keys(Keys.RETURN)

        # Wait for the results to load
        time.sleep(2)

        # Scrape search result titles and links
        results = []
        search_results = driver.find_elements(By.CSS_SELECTOR, "div.yuRUbf a")
        for result in search_results[:max_results]:
            title = result.find_element(By.TAG_NAME, "h3").text
            link = result.get_attribute("href")
            results.append({"title": title, "link": link})

        return results

    finally:
        # Close the WebDriver
        driver.quit()

# Example usage
if __name__ == "__main__":
    query = "Selenium Python tutorial"
    search_results = scrape_google_search(query)

    for idx, result in enumerate(search_results, 1):
        print(f"{idx}. {result['title']}: {result['link']}")
